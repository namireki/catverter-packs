{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:com.namirekistudio.catverter:schema:facts:v1",
  "title": "Catverter cat facts v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "documentType", "schemaVersion",
    "version", "minimumAppVersion", "facts"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "documentType": { "const": "catverter-facts" },
    "schemaVersion": { "const": 1 },
    "version": { "$ref": "#/$defs/version" },
    "minimumAppVersion": { "$ref": "#/$defs/version" },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/fact" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}$"
    },
    "localizedText": {
      "type": "object",
      "minProperties": 1,
      "required": ["en"],
      "propertyNames": {
        "pattern": "^[a-z]{2}(?:-[A-Za-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "conversionId"],
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^packs/[a-z0-9](?:[a-z0-9-]*[a-z0-9])?/[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\\.json$"
        },
        "conversionId": { "$ref": "#/$defs/id" }
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "category", "text"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": {
          "type": "string",
          "enum": ["fact", "comparison", "absurd-comparison"]
        },
        "category": { "$ref": "#/$defs/id" },
        "text": { "$ref": "#/$defs/localizedText" },
        "references": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/reference" }
        },
        "note": { "type": "string", "minLength": 1 },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    }
  }
}
