{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:com.namirekistudio.catverter:schema:catalog:v1",
  "title": "Catverter pack catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "documentType", "schemaVersion", "repositoryId",
    "version", "minimumAppVersion", "packs"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "documentType": { "const": "catverter-catalog" },
    "schemaVersion": { "const": 1 },
    "repositoryId": { "$ref": "#/$defs/packageId" },
    "version": { "$ref": "#/$defs/version" },
    "minimumAppVersion": { "$ref": "#/$defs/version" },
    "contentBaseUrl": {
      "type": "string",
      "pattern": "^https://[^{}]+/\\{revision\\}/$"
    },
    "sourceCatalog": { "$ref": "#/$defs/sourceCatalog" },
    "packs": {
      "type": "array", "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    },
    "locales": {
      "type": "array",
      "items": { "$ref": "#/$defs/localeEntry" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
    },
    "packageId": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?){2,}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}$"
    },
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sourceCatalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "file", "repositoryId", "version"],
      "properties": {
        "repository": { "$ref": "#/$defs/httpsUrl" },
        "revision": { "$ref": "#/$defs/revision" },
        "file": { "type": "string", "pattern": "^packs/catalog\\.json$" },
        "repositoryId": { "$ref": "#/$defs/packageId" },
        "version": { "$ref": "#/$defs/version" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "file", "sha256"],
      "properties": {
        "repository": { "$ref": "#/$defs/httpsUrl" },
        "revision": { "$ref": "#/$defs/revision" },
        "file": {
          "type": "string",
          "pattern": "^packs/(?:locales/)?[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\\.json$"
        },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packageId", "id", "version", "file", "sha256"],
      "properties": {
        "packageId": { "$ref": "#/$defs/packageId" },
        "id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/version" },
        "classification": {
          "type": "string",
          "enum": ["official", "contributed"]
        },
        "maintainer": { "$ref": "#/$defs/id" },
        "file": {
          "type": "string",
          "pattern": "^packs/[a-z0-9](?:[a-z0-9-]*[a-z0-9])?/[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\\.json$"
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "localeEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locale", "name", "file", "sha256"],
      "properties": {
        "locale": { "type": "string", "minLength": 2 },
        "name": { "type": "string", "minLength": 1 },
        "file": {
          "type": "string",
          "pattern": "^locales/[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\\.json$"
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "source": { "$ref": "#/$defs/source" }
      }
    }
  }
}
