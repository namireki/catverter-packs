{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:com.namirekistudio.catverter:schema:pack:v1",
  "title": "Catverter conversion pack v1",
  "description": "The first public Catverter conversion pack contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "documentType", "schemaVersion", "packageId", "id",
    "name", "version", "minimumAppVersion", "description", "conversions"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "documentType": { "const": "catverter-pack" },
    "schemaVersion": { "const": 1 },
    "packageId": { "$ref": "#/$defs/packageId" },
    "id": { "$ref": "#/$defs/id" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "$ref": "#/$defs/version" },
    "minimumAppVersion": { "$ref": "#/$defs/version" },
    "description": { "type": "string", "minLength": 1 },
    "metadata": { "$ref": "#/$defs/metadata" },
    "modifiers": {
      "type": "array",
      "items": { "$ref": "#/$defs/modifier" }
    },
    "conversions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/conversion" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
    },
    "packageId": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?){2,}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}$"
    },
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "authors": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "license": { "type": "string", "minLength": 1 },
        "homepage": { "$ref": "#/$defs/httpsUrl" },
        "repository": { "$ref": "#/$defs/httpsUrl" },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "accentColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "iconUrl": { "$ref": "#/$defs/httpsUrl" }
      }
    },
    "modifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "multiplier", "combinationGroup"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "multiplier": { "type": "number", "exclusiveMinimum": 0 },
        "quantities": {
          "type": "array", "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "aspects": {
          "type": "array", "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "combinationGroup": { "$ref": "#/$defs/id" },
        "incompatibleWith": {
          "type": "array", "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "conversion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "singularName", "pluralName", "quantity", "unit", "value"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "singularName": { "type": "string", "minLength": 1 },
        "pluralName": { "type": "string", "minLength": 1 },
        "quantity": { "type": "string", "minLength": 1 },
        "unit": { "type": "string", "minLength": 1 },
        "value": { "type": "number", "exclusiveMinimum": 0 },
        "aspect": { "$ref": "#/$defs/id" },
        "modifierIds": {
          "type": "array", "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "sourceUrl": { "$ref": "#/$defs/httpsUrl" },
        "notes": { "type": "string", "maxLength": 1000 }
      }
    }
  }
}
