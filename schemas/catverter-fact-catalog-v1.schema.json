{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:com.namirekistudio.catverter:schema:fact-catalog:v1",
  "title": "Catverter fact catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "documentType", "schemaVersion", "version",
    "minimumAppVersion", "contentBaseUrl", "documents"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "documentType": { "const": "catverter-fact-catalog" },
    "schemaVersion": { "const": 1 },
    "version": { "$ref": "#/$defs/version" },
    "minimumAppVersion": { "$ref": "#/$defs/version" },
    "contentBaseUrl": {
      "type": "string",
      "pattern": "^https://[^{}]+/\\{revision\\}/$"
    },
    "presentation": { "$ref": "#/$defs/presentation" },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/document" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}$"
    },
    "localizedText": {
      "type": "object",
      "minProperties": 1,
      "required": ["en"],
      "propertyNames": {
        "pattern": "^[a-z]{2}(?:-[A-Za-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "gitSha"],
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^facts/[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\\.(?:jpg|jpeg|png|webp)$"
        },
        "gitSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "image", "altText"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "image": { "$ref": "#/$defs/image" },
        "altText": { "$ref": "#/$defs/localizedText" }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host"],
      "properties": {
        "host": { "$ref": "#/$defs/host" }
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "file", "sha256"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "file": {
          "type": "string",
          "pattern": "^facts/[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\\.json$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
