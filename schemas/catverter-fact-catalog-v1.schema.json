{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:com.namirekistudio.catverter:schema:fact-catalog:v1",
  "title": "Catverter fact catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "documentType", "schemaVersion", "version",
    "minimumAppVersion", "contentBaseUrl", "documents"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "documentType": { "const": "catverter-fact-catalog" },
    "schemaVersion": { "const": 1 },
    "version": { "$ref": "#/$defs/version" },
    "minimumAppVersion": { "$ref": "#/$defs/version" },
    "contentBaseUrl": {
      "type": "string",
      "pattern": "^https://[^{}]+/\\{revision\\}/$"
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/document" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}$"
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "file", "sha256"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "file": {
          "type": "string",
          "pattern": "^facts/[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\\.json$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
